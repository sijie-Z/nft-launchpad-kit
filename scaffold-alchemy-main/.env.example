# Template for shared environment variables between hardhat and nextjs

# To use this template, copy this file, rename it .env, and fill in the values.

# ===== Required =====

# Alchemy RPC API key (https://dashboard.alchemy.com)
# Used by the frontend RPC and the hardhat Sepolia network config.
# NOTE: never commit real keys to the repo.
ALCHEMY_API_KEY=

# SQLite database connection string (required by Prisma, see packages/nextjs/lib/env.ts)
# For local dev with a file-based DB:
DATABASE_URL=file:./dev.db

# Deployer wallet private key (without 0x prefix) — only needed for testnet deploys
PRIVATE_KEY=

# ===== Optional =====

# Alchemy Gas Manager policy ID (account abstraction gas sponsorship)
ALCHEMY_GAS_POLICY_ID=

# Etherscan API key for contract verification
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Trusted signer private key for signature mint API (/api/signature)
# This should be the same key as the address set via setTrustedSigner()
# Without 0x prefix
SIGNER_PRIVATE_KEY=

# Override the Sepolia RPC URL (defaults to Alchemy based on ALCHEMY_API_KEY)
SEPOLIA_RPC_URL=

# Pinata JWT for the AI metadata pipeline (/api/metadata/generate, v3 uploads API)
# Get one at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# Base Sepolia (#37) — deploy target for the agent economy chain
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Platform API key for cross-origin writes (SDK/agent calls).
# Same-origin frontend requests are exempt; leave empty to keep writes open.
PLATFORM_API_KEY=
