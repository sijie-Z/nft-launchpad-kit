generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户（钱包连接后自动创建）
model User {
  id        String   @id @default(cuid())
  address   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCollections Collection[]
  mintRecords     MintRecord[]
}

// NFT 集合
model Collection {
  id              String   @id @default(cuid())
  name            String
  symbol          String
  description     String?
  coverImage      String?
  contractAddress String?  @unique
  chainId         Int      @default(11155111)
  maxSupply       Int
  mintPrice       String
  maxPerWallet    Int
  status          String   @default("draft")
  ownerId         String

  baseURI         String?
  preRevealURI    String?
  revealSeed      Int?

  platformFeeBps  Int      @default(500)
  royaltyBps      Int      @default(500)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation(fields: [ownerId], references: [id])
  mintRecords     MintRecord[]
  claimPhases     ClaimPhase[]
  whitelistEntries WhitelistEntry[]
}

// 铸造记录
model MintRecord {
  id            String   @id @default(cuid())
  txHash        String
  minterAddress String
  tokenId       Int?
  quantity      Int
  totalPaid     String
  mintMode      String
  chainId       Int      @default(11155111)
  collectionId  String
  userId        String?
  createdAt     DateTime @default(now())

  collection    Collection @relation(fields: [collectionId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])
}

// Claim Phase 配置
model ClaimPhase {
  id                     String   @id @default(cuid())
  phaseId                Int
  startTimestamp         DateTime
  maxSupply              Int
  quantityLimitPerWallet Int
  currency               String   @default("0x0000000000000000000000000000000000000000")
  pricePerToken          String
  merkleRoot             String?
  metadata               String?
  collectionId           String
  createdAt              DateTime @default(now())

  collection             Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, phaseId])
}

// 白名单条目
model WhitelistEntry {
  id           String   @id @default(cuid())
  address      String
  maxMint      Int      @default(1)
  collectionId String
  createdAt    DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, address])
}

// 平台配置
model PlatformConfig {
  id             String @id @default("default")
  platformFeeBps Int    @default(500)
  platformWallet String?
  updatedAt      DateTime @updatedAt
}

// Agent 身份（#40 — agent 即创作者的产品层）
// 字段参考 agent identity 生态惯例（chancery / agent meta 等）：
// registry = 地址注册；capabilities = 能力声明；grants = 授权审计。
model Agent {
  id           String   @id @default(cuid())
  address      String   @unique
  name         String
  description  String?
  capabilities String? // 能力声明（JSON 字符串），如 ["mint", "membership", "reward"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grants AgentGrant[]
}

// Agent 铸造授权记录（防篡改审计 —— 链上事件 + 链下记录）
model AgentGrant {
  id                String   @id @default(cuid())
  agentId           String
  collectionAddress String? // 作用域：哪个集合
  minter            String? // 作用域：给谁
  quantity          Int?
  pricePerToken     String?
  deadline          Int?
  uid               String? @unique // 一次性授权 ID（与链上 uid 对应）
  status            String   @default("issued") // issued | used | expired | revoked
  createdAt         DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id])
}
